# rust >= 1.88: let-chains in if/let expressions (used in handler/transport/storage)
FROM docker.io/rust:1.88.0-alpine AS bot_builder

# build-base: cc/gcc needed by ring (reqwest rustls-tls)
RUN apk update \
    && apk add --no-cache --purge libc-dev openssl-dev openssl-libs-static pkgconfig build-base

WORKDIR /work

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry cargo fetch
# 注意：刻意不使用 --mount=type=cache,target=/work/target 缓存编译产物。
# 该 cache mount 曾导致 cargo 误判源码未变、跳过重编译，产出旧二进制。
# 每次源码变化时全量编译（NAS 上约 6-7 分钟），保证镜像与源码一致。
RUN --mount=type=cache,target=/usr/local/cargo/registry cargo build --release && cp /work/target/release/telegram_sync_bot /work/telegram_sync_bot

########################################

FROM docker.io/alpine:latest AS bot

WORKDIR /app

RUN apk update \
    && apk add --no-cache --purge bash tzdata

COPY --from=bot_builder /work/telegram_sync_bot /app

STOPSIGNAL SIGINT

ENTRYPOINT ["/app/telegram_sync_bot"]

CMD ["--help"]
